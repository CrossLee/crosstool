#!/bin/bash

set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
# This helper and expected-app.plist are covered by the signed PKG.
source "$SCRIPT_DIR/migration-common.sh"
onepaw_initialize "${3:-/}"
onepaw_preinstall "$SCRIPT_DIR/expected-app.plist"
